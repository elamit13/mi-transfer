{
  "manifest_version": 2,
  "name": "Mint Downloader IDM Integration",
  "version": "1.0.0",
  "description": "Integración estilo IDM para Mint Downloader: botón flotante sobre videos con selector de resoluciones, detector de streams en la pestaña e intercepción automática de descargas.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "downloads",
    "webRequest",
    "tabs",
    "activeTab",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Mint Downloader - Videos y Descargas",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mint-downloader@linuxmint.org",
      "strict_min_version": "109.0"
    }
  }
}
